{
  "expo": {
    "name": "FitPro",
    "slug": "fitpro-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F2027"
    },
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.fitpro.mobile" },
    "android": {
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0F2027" },
      "package": "com.fitpro.mobile"
    },
    "plugins": ["expo-font"]
  }
}
